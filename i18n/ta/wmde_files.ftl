# WMDE additions (Win11-style chrome)
search = தேடு
search-placeholder = { $name } இல் தேடுக
search-title = "{ $term }" தேடல்: { $name }
status-items =
    { $items } { $items ->
        [one] உருப்படி
       *[other] உருப்படிகள்
    }
status-selected = { $selected } தேர்ந்தெடுக்கப்பட்டது
status-disk = { $total } | பயன்பாட்டில் { $used } | காலியாக { $free }

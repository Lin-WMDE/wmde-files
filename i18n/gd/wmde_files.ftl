# WMDE additions (Win11-style chrome)
search = Lorg
search-placeholder = Lorg { $name }
search-title = Lorg “{ $term }”: { $name }
status-items =
    { $items } { $items ->
        [one] nì
        [two] nì
        [few] nithean
       *[other] nì
    }
status-selected = { $selected } air a thaghadh
status-disk = { $total } | { $used } air a chleachdadh | { $free } saor

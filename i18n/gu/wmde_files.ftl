# WMDE additions (Win11-style chrome)
search = શોધો
search-placeholder = { $name }માં શોધો
search-title = "{ $term }" શોધો: { $name }
status-items =
    { $items } { $items ->
        [one] વસ્તુ
       *[other] વસ્તુઓ
    }
status-selected = { $selected } પસંદ કરેલ
status-disk = { $total } | { $used } વપરાયેલ | { $free } ખાલી

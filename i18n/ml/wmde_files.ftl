# WMDE additions (Win11-style chrome)
search = തിരയുക
search-placeholder = { $name }-ൽ തിരയുക
search-title = "{ $term }" തിരയുക: { $name }
status-items =
    { $items } { $items ->
        [one] ഇനം
       *[other] ഇനങ്ങൾ
    }
status-selected = { $selected } തിരഞ്ഞെടുത്തു
status-disk = { $total } | { $used } ഉപയോഗിച്ചു | { $free } ലഭ്യം

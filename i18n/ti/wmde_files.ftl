# WMDE additions (Win11-style chrome)
search = ድለ
search-placeholder = ኣብ { $name } ድለ
search-title = «{ $term }» ድለ: { $name }
status-items =
    { $items } { $items ->
        [one] ኣቕሓ
       *[other] ኣቕሑ
    }
status-selected = { $selected } ተመሪጹ
status-disk = { $total } | { $used } ተጠቒሙ | { $free } ናጻ

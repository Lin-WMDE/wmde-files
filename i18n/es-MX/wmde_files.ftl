# WMDE additions (Win11-style chrome)
search = Buscar
search-placeholder = Buscar en { $name }
search-title = Buscar “{ $term }”: { $name }
status-items =
    { $items } { $items ->
        [one] elemento
        [many] de elementos
       *[other] elementos
    }
status-selected = { $selected } seleccionados
status-disk = { $total } | { $used } en uso | { $free } libres

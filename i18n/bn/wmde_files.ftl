# WMDE additions (Win11-style chrome)
search = অনুসন্ধান
search-placeholder = অনুসন্ধান: { $name }
search-title = অনুসন্ধান "{ $term }": { $name }
status-items =
    { $items } { $items ->
        [one] আইটেম
       *[other] আইটেম
    }
status-selected = { $selected } নির্বাচিত
status-disk = { $total } | { $used } ব্যবহৃত | { $free } খালি

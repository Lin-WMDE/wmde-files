# WMDE additions (Win11-style chrome)
search = ຄົ້ນຫາ
search-placeholder = ຄົ້ນຫາ { $name }
search-title = ຄົ້ນຫາ "{ $term }": { $name }
status-items =
    { $items } { $items ->
       *[other] ລາຍການ
    }
status-selected = ເລືອກແລ້ວ { $selected }
status-disk = { $total } | ໃຊ້ແລ້ວ { $used } | ຫວ່າງ { $free }
